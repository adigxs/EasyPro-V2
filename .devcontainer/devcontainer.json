{
  "name": "Django + Flutter Azure Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y curl unzip xz-utils zip libglu1-mesa && pip install -r backend/requirements.txt && git clone https://github.com/flutter/flutter.git -b stable /workspaces/flutter && echo 'export PATH=/workspaces/flutter/bin:$PATH' >> ~/.bashrc",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "ms-azuretools.vscode-docker",
        "Dart-Code.flutter",
        "Dart-Code.dart-code",
        "GitHub.vscode-github-actions"
      ]
    }
  },
  "forwardPorts": [8000, 3000],
  "portsAttributes": {
    "8000": {
      "label": "Django API",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Flutter Web",
      "onAutoForward": "notify"
    }
  }
}
